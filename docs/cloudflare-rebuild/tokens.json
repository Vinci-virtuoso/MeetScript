          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "timestamp": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, monospace",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }

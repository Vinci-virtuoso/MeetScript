{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/setup.ts",
    "tests/worker/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests/e2e"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "@cloudflare/vitest-plugin/types"
    ],
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}

{
  "name": "rent-split",
  "version": "0.2.0",
  "private": true,
  "description": "Split rent fairly in the browser; accounts, saved splits and a Pro plan on Astro + Workers (platform-kit)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --port 8787 --ip 127.0.0.1 --persist-to .wrangler/state",
    "dev:vars": "node scripts/write-dev-vars.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "typecheck": "wrangler types && astro check && tsc -p tsconfig.web.json",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "test:load": "node tests/load/events-load.mjs",
    "verify": "npm run dev:vars && npm run typecheck && vitest run && npm run build && npm run db:migrate && playwright test && npm audit --omit=dev",
    "test": "npm run verify"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.1",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.2",
    "autocannon": "8.0.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@whlong/eventbase": "0.15.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "hono": "4.13.13",
    "loginbase": "3.1.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
